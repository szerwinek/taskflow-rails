<div class="narrow"><p class="eyebrow"><%= link_to @project.name, @project %> / ZADANIE</p><h1><%= @task.title %></h1><div class="detail-strip"><%= task_status(@task.status) %><span>Priorytet: <strong><%= @task.priority_label %></strong></span><span>Termin: <strong><%= @task.due_date&.strftime("%d.%m.%Y") || "—" %></strong></span></div><section class="section"><h2>Opis</h2><p class="description"><%= @task.description.presence || "Brak opisu zadania." %></p><div class="actions"><%= link_to "Edytuj", edit_project_task_path(@project, @task), class: "btn primary" %><%= link_to "Wróć do projektu", @project, class: "btn secondary" %></div></section></div>
