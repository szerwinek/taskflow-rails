<div class="page-heading"><div><p class="eyebrow">PROJEKT</p><h1><%= @project.name %></h1><p class="muted"><%= @project.description.presence || "Brak opisu." %></p></div><div class="actions"><%= link_to "Edytuj", edit_project_path(@project), class: "btn secondary" %><%= button_to "Usuń", project_path(@project), method: :delete, form: { data: { turbo_confirm: "Usunąć projekt wraz ze wszystkimi zadaniami?" } }, class: "btn danger" %></div></div>
<div class="detail-strip"><span class="pill <%= @project.status %>"><%= @project.status == "active" ? "Aktywny" : "Archiwalny" %></span><span>Termin: <strong><%= @project.deadline&.strftime("%d.%m.%Y") || "Nie określono" %></strong></span><span>Zadań: <strong><%= @tasks.count %></strong></span></div>
<section class="section"><div class="section-heading"><h2>Zadania projektu</h2><%= link_to "+ Dodaj zadanie", new_project_task_path(@project), class: "btn primary" %></div>
<% if @tasks.any? %><div class="table-wrap"><table><thead><tr><th>Nazwa</th><th>Priorytet</th><th>Status</th><th>Termin</th><th>Akcje</th></tr></thead><tbody>
<% @tasks.each do |task| %><tr><td><strong><%= link_to task.title, project_task_path(@project, task) %></strong></td><td><%= task.priority_label %></td><td><%= task_status(task.status) %></td><td><%= task.due_date&.strftime("%d.%m.%Y") || "—" %></td><td class="nowrap"><%= link_to "Edytuj", edit_project_task_path(@project, task) %> · <%= button_to "Usuń", project_task_path(@project, task), method: :delete, form: { data: { turbo_confirm: "Usunąć zadanie?" } }, class: "link-button" %></td></tr><% end %>
</tbody></table></div><% else %><div class="empty"><h3>Brak zadań</h3><p>Dodaj zadania, aby rozbić projekt na mniejsze etapy.</p></div><% end %></section>
